% 通用中文课程报告样式；请用 XeLaTeX 编译。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{course-report}[2026/11/01 General Chinese course report]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{course-report}{Please compile with XeLaTeX}{Select XeLaTeX as the compiler.}
\fi
\RequirePackage[a4paper,left=2.8cm,right=2.8cm,top=2.6cm,bottom=2.6cm,headheight=15pt]{geometry}
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{array,tabularx,booktabs,multirow,longtable}
\RequirePackage{caption,subcaption}
\RequirePackage{siunitx}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{listings}
\RequirePackage{algorithm}
\RequirePackage[noend]{algpseudocode}
\RequirePackage{hyperref}
\hypersetup{hidelinks,bookmarksnumbered=true,pdfdisplaydoctitle=true}
\urlstyle{same}

% 正文：小四号宋体，首行缩进两字，约 1.5 倍行距。
\AtBeginDocument{\zihao{-4}}
\linespread{1.3}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\setcounter{tocdepth}{2}
\ctexset{
  section={format=\centering\heiti\zihao{3},beforeskip=1.4em,afterskip=0.8em},
  subsection={format=\heiti\zihao{4},beforeskip=1em,afterskip=0.5em},
  subsubsection={format=\heiti\zihao{-4},beforeskip=0.8em,afterskip=0.4em}
}
\setlist{nosep,topsep=0.4em,leftmargin=*}
\setlength{\emergencystretch}{2em}

% 保留参考文件中的浅蓝配色；表格默认不加底色，按需使用。
\definecolor{TableHead}{RGB}{199,224,252}
\definecolor{TableStripe}{RGB}{224,235,245}
\definecolor{CodeBackground}{RGB}{245,247,249}
\definecolor{CodeKeyword}{RGB}{38,84,124}
\definecolor{CodeComment}{RGB}{89,106,95}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}
\newcolumntype{P}[1]{>{\centering\arraybackslash}p{#1}}
\renewcommand{\arraystretch}{1.25}
\setlength{\tabcolsep}{7pt}
\captionsetup{font=small,labelsep=quad,skip=6pt}
\captionsetup[table]{position=top}
\captionsetup[figure]{position=bottom}
\captionsetup[subfigure]{font=small}
\graphicspath{{figures/}}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}
\renewcommand{\refname}{参考文献}
\renewcommand{\contentsname}{目录}
\floatname{algorithm}{算法}
\renewcommand{\algorithmicrequire}{\textbf{输入：}}
\renewcommand{\algorithmicensure}{\textbf{输出：}}
\providecommand{\figureautorefname}{图}
\providecommand{\tableautorefname}{表}
\providecommand{\equationautorefname}{式}
\providecommand{\sectionautorefname}{节}
\providecommand{\subsectionautorefname}{节}
\providecommand{\algorithmautorefname}{算法}
\renewcommand{\figureautorefname}{图}
\renewcommand{\tableautorefname}{表}
\renewcommand{\equationautorefname}{式}
\renewcommand{\sectionautorefname}{节}
\renewcommand{\subsectionautorefname}{节}

\lstdefinestyle{reportcode}{
  basicstyle=\small\ttfamily,
  keywordstyle=\color{CodeKeyword}\bfseries,
  commentstyle=\color{CodeComment},
  stringstyle=\color{CodeKeyword},
  backgroundcolor=\color{CodeBackground},
  frame=single,rulecolor=\color{black!20},
  numbers=left,numberstyle=\scriptsize\color{black!50},numbersep=10pt,
  breaklines=true,breakatwhitespace=false,
  columns=fullflexible,keepspaces=true,showstringspaces=false,
  tabsize=4,captionpos=b,aboveskip=1em,belowskip=0.5em,
  xleftmargin=1.8em,framexleftmargin=0.4em
}
\lstset{style=reportcode}
\renewcommand{\lstlistingname}{代码}

% 报告信息集中在主文件中设置；题目和姓名同时写入 PDF 元数据。
\newcommand{\ReportTitle}{课程报告题目}
\newcommand{\ReportType}{课程报告}
\newcommand{\CourseName}{课程名称}
\newcommand{\StudentName}{}
\newcommand{\ReportHeader}{\CourseName\quad\ReportType}
\AtBeginDocument{\hypersetup{pdftitle={\ReportTitle},pdfauthor={\StudentName}}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\ReportHeader}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{
  \fancyhf{}\fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% 若课程要求摘要，可在目录之后按需使用此环境。
\newenvironment{reportabstract}{%
  \clearpage
  \phantomsection\addcontentsline{toc}{section}{摘要}
  \section*{摘要}
}{\par\clearpage}
\newcommand{\keywords}[1]{\par\vspace{0.8em}\noindent\textbf{关键词：}#1\par}
\newcommand{\MakeReportContents}{\tableofcontents\clearpage}
\newcommand{\StartReportBody}{\clearpage\pagenumbering{arabic}}

% 无需外部图片即可编译。将占位图替换为 \includegraphics 即可。
\newcommand{\FigurePlaceholder}[2][3.5cm]{%
  \begingroup
  \setlength{\fboxsep}{0pt}%
  \fcolorbox{black!30}{black!2}{%
    \parbox[c][#1][c]{\dimexpr\linewidth-2\fboxrule\relax}{%
      \centering\small\color{black!55}#2}}%
  \endgroup
}
\endinput
